# Maintainer: Choreographr Maintainers <maintainers@choreographr.com>
#
# choreographr-bin — PREBUILT package. The -bin suffix is an Arch convention
# that is REQUIRED for packages installing prebuilt binaries rather than
# building from source; the plain name (choreographr) is reserved for a source
# package. A future source package could build from the release source tarball
# with `makedepends=(zig)` (the workspace needs zig for the zlob dependency)
# — left as a future option for now.
#
# Bump procedure: bump pkgver, reset pkgrel to 1, update the source URL and
# sha256sums (the musl tarball's digest from the release's SHA256SUMS), then
# regenerate packaging/aur/.SRCINFO with: makepkg --printsrcinfo > .SRCINFO

pkgname=choreographr-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="Agentic coding assistant — daemon, TUI, and bridges"
arch=('x86_64')
url="https://choreographr.com"
license=('Apache-2.0')
# Empty depends: the release binaries are static — no runtime dependencies.
depends=()
# The Linux release tarball is the fully static musl build (see
# scripts/release.sh): one artifact serves general Linux AND the AUR -bin
# package.
source=("https://github.com/choreographr/choreographr/releases/download/v0.2.0/choreographr-0.2.0-x86_64-unknown-linux-musl.tar.gz")
# The digest of the exact release tarball, from the release's SHA256SUMS
# (choreographr-<V>-x86_64-unknown-linux-musl.tar.gz). Update it with pkgver.
sha256sums=('58efee8c92187cb3686a5a30f0014aac29b6bd9094cfc7ac0a0f420b02053f6c')

package() {
    # Release tarball layout: the shipped binaries at the top level, exec bits
    # preserved (see scripts/release.sh). The IM/ACP bridges are feature-gated
    # and not in the tarball; choreo-mcp is a library-only crate (no binary).
    cd "$srcdir"
    install -Dm755 choreographr "$pkgdir/usr/bin/choreographr"
    install -Dm755 choreo-tui      "$pkgdir/usr/bin/choreo-tui"
}
